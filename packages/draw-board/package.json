{
  "name": "markup-board",
  "version": "0.2.0",
  "description": "A React + Konva drawing and annotation board: freehand, shapes, text, images, groups, pan/zoom, PNG/SVG export with embedded editable source.",
  "license": "MIT",
  "author": "Nick Marso",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeKinci/sketchbook.git",
    "directory": "packages/draw-board"
  },
  "homepage": "https://github.com/DeKinci/sketchbook/tree/develop/packages/draw-board#readme",
  "bugs": {
    "url": "https://github.com/DeKinci/sketchbook/issues"
  },
  "keywords": [
    "react",
    "konva",
    "drawing",
    "whiteboard",
    "annotation",
    "canvas",
    "sketch"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./theme": {
      "types": "./src/theme.ts",
      "default": "./src/theme.ts"
    },
    "./keymap": {
      "types": "./src/keymap.ts",
      "default": "./src/keymap.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./theme": {
        "types": "./dist/theme.d.ts",
        "default": "./dist/theme.js"
      },
      "./keymap": {
        "types": "./dist/keymap.d.ts",
        "default": "./dist/keymap.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "konva": ">=10",
    "lucide-react": ">=1",
    "react": ">=18",
    "react-dom": ">=18",
    "react-konva": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^2.1.9",
    "konva": "^10.3.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-konva": "^19.2.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  }
}

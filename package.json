{
  "name": "sketchbook-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:browser": "pnpm --filter sketchbook test:browser",
    "dev": "pnpm --filter sketchbook dev",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "node scripts/publish.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "typescript": "^5.7.2"
  }
}
